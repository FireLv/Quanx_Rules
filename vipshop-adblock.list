# Vipshop (唯品会) 开屏广告屏蔽 - Quantumult X 分流规则
# 基于 2026-09-08 HAR 抓包分析生成 (iOS 唯品会 v9.83.3)
# 用法: Quantumult X -> 配置 -> 分流规则 -> 右上角 + -> 筛选 -> 粘贴本文件 raw URL -> 获取
#
# 说明:
#   - appsimg.com 是混合 CDN: 仅屏蔽运营/广告素材目录 (momin/mst), 保留商品图 (merchandise) 与品牌图 (brand)
#   - mapi.appvipshop.com 是核心 API 网关, 不能整域屏蔽, 只精确匹配广告接口
#   - 开屏总开关 startup/v3 返回首页菜单等关键数据, 不能 REJECT, 需配合脚本改写 (见 README / startup_v3.js)

# --- 开屏广告取数接口 (核心) ---
url, ^https?://mapi\.appvipshop\.com/vips-mobile/rest/activity/advertisement/get, REJECT

# --- 弹窗 / 悬浮球 / 浮层广告 ---
url, ^https?://mapi\.appvipshop\.com/vips-mobile/rest/operation/popup/v1, REJECT
url, ^https?://mapi\.appvipshop\.com/vips-mobile/rest/layout/assistant/float_ball, REJECT
url, ^https?://mapi\.appvipshop\.com/vips-mobile/rest/activity/float_ball/get, REJECT

# --- 广告/运营素材目录 (momin/mst), 保留 merchandise(商品图)/brand(品牌图) ---
url, ^https?://(b|h2)\.appsimg\.com/.+/(momin|mst)/, REJECT

# --- 广告曝光/点击埋点 (可选, 可自行删除) ---
url, ^https?://sc\.appvipshop\.com/vips-mobile-tracker/router\.do.*(advtrigger|adv|advert), REJECT
